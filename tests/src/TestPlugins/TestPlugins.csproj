<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>TestPlugins</AssemblyName>
    <RootNamespace>TestPlugins</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>TestPlugins.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- The fixtures are deliberately empty, so unused parameters are the point. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The very file the documenter drops into a user's project. Linking it here means the
      fixtures compile against the same definitions the tool emits, so a build after a run
      is itself a test: if the generated attributes do not compile, this project breaks.
    -->
    <Compile Include="..\..\..\assets\XrmToolsMetaAttributes.cs" Link="XrmToolsMetaAttributes.cs" />
    <!--
      Shared with Contoso.Crm.Plugins, which links the same file. Shared.Twin is therefore
      a type in both assemblies and is registered from both, against one .cs.
    -->
    <Compile Include="..\Shared\Twin.cs" Link="Shared\Twin.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

</Project>
