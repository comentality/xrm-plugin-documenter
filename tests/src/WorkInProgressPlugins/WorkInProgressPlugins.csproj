<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The assembly nobody packed into anything: registered record by record against a
    development environment, the way the plugin registration tool does it, which is where
    the documenter is actually used. It shares TestPlugins' key because it is the same
    developer's second project, not a second vendor.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>WorkInProgress.Plugins</AssemblyName>
    <RootNamespace>WorkInProgress</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\TestPlugins\TestPlugins.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\assets\XrmToolsMetaAttributes.cs" Link="XrmToolsMetaAttributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

</Project>
