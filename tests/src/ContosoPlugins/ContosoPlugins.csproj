<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The second vendor in the fixture: a different publisher, a different solution and a
    different strong name key from TestPlugins, so the two are only ever told apart by
    things the tool can actually see.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Contoso.Crm.Plugins</AssemblyName>
    <RootNamespace>Contoso.Crm</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\keys\Contoso.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\assets\XrmToolsMetaAttributes.cs" Link="XrmToolsMetaAttributes.cs" />
    <!--
      The same file TestPlugins links, so Shared.Twin is a type in both assemblies and
      both registrations point at this one .cs.
    -->
    <Compile Include="..\Shared\Twin.cs" Link="Shared\Twin.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

</Project>
