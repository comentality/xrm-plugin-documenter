<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Named Microsoft, signed by Contoso.

    AssemblyInfo.IsMicrosoft asks the strong name key first and falls back to the name, and
    this is the assembly where the fallback is wrong: it carries the same key as
    Contoso.Crm.Plugins, which is nobody's idea of a first party signature, and is still
    hidden until the Microsoft switch is on. Same key as its neighbours on purpose - it is
    the name and nothing else that gets it filtered out.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Microsoft.Contoso.Extensions</AssemblyName>
    <RootNamespace>Microsoft.Contoso</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\keys\Contoso.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\assets\XrmToolsMetaAttributes.cs" Link="XrmToolsMetaAttributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

</Project>
