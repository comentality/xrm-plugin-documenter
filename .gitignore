bin/
obj/
.vs/
*.user
*.suo
# Local Claude state stays out; the skills are part of the project.
.claude/*
!.claude/skills/
.nuget-apikey
artifacts/
# The tool leaves one of these beside every file it rewrites, including the fixtures.
*.bak
# The private XrmToolBox instance xtb.ps1 builds, including its connection and its token cache.
tests/.xtb/
# Layout screenshots from ui.ps1, rewritten on every run.
tests/.ui/
# Sandboxes write.ps1 copies the fixtures into, rebuilt on every run. Not under
# tests/obj, because the tool skips any path with \obj\ in it as build output.
tests/.write/

# Working folder compat.ps1 builds its probes in, rebuilt on every run.
tests/.compat/
