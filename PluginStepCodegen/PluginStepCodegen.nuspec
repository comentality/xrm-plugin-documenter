<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Comentality.PluginStepCodegen</id>
    <version>1.1.0</version>
    <title>Plugin Step Codegen</title>
    <authors>Comentality</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/comentality/xrm-plugin-step-codegen</projectUrl>
    <repository type="git" url="https://github.com/comentality/xrm-plugin-step-codegen.git" branch="main" />
    <icon>icon.png</icon>
    <readme>docs\README.md</readme>
    <description>Document Dataverse plugin step registrations directly in your C# source. Reads registered steps and images from the connected environment and writes them back into your plugin classes as Xrm Tools compatible [Plugin], [Step] and [Image] attributes.</description>
    <releaseNotes>v1.1.0 - "All columns except" phrasing (experimental), source folder scan with per-class file status, write-to-both-files for ambiguous classes, togglable preview, refresh, namespace-aware file matching. Full changelog: https://github.com/comentality/xrm-plugin-step-codegen/blob/main/CHANGELOG.md</releaseNotes>
    <tags>XrmToolBox Dynamics365 CRM PowerPlatform Dataverse Plugin Registration Documentation Codegen XrmTools</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="1.2025.7.71" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\PluginStepCodegen.dll" target="Plugins\PluginStepCodegen.dll" />
    <file src="icon.png" target="icon.png" />
    <file src="..\README.md" target="docs\README.md" />
  </files>
</package>
