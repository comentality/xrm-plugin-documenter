<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>PluginDocumenter</id>
    <version>1.0.0</version>
    <title>Plugin Documenter</title>
    <authors>Comentality</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/comentality/xrm-plugin-documenter</projectUrl>
    <icon>icon.png</icon>
    <readme>docs\README.md</readme>
    <description>Document Dataverse plugin step registrations directly in your C# source. Reads registered steps and images from the connected environment and writes them back into your plugin classes as Xrm Tools compatible [Plugin], [Step] and [Image] attributes.</description>
    <releaseNotes>v1.0.0 - Initial release: read registered plugin steps and images, emit Xrm Tools compatible attributes into matching .cs files, and generate a dependency-free attribute definitions file.</releaseNotes>
    <tags>XrmToolBox Dynamics365 CRM PowerPlatform Dataverse Plugin Registration Documentation Documenter XrmTools</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="1.2025.7.71" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\PluginDocumenter.dll" target="Plugins\PluginDocumenter.dll" />
    <file src="icon.png" target="icon.png" />
    <file src="..\README.md" target="docs\README.md" />
  </files>
</package>
